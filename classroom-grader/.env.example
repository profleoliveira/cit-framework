# Chave da API Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Caminho para o arquivo de credenciais OAuth2 do Google
# Gere em: https://console.cloud.google.com/ > APIs & Services > Credentials
GOOGLE_CREDENTIALS_FILE=credentials.json

# Modelo Claude a usar (opcional, padrão: claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6
